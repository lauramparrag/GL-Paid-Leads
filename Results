/* ── Date handling: LEADS use "YYYY-MM-DD HH:MM:SS", GLEADS use "M/D/YYYY" ── */
function parseDateAny(s){
  s = (s||"").trim(); if(!s) return null;
  var iso = /^(\d{4})-(\d{2})-(\d{2})/.exec(s);
  if(iso) return { y:+iso[1], m:+iso[2], d:+iso[3] };
  var us = /^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(s);
  if(us) return { y:+us[3], m:+us[1], d:+us[2] };
  return null;
}
function dateShort(s){ var p=parseDateAny(s); if(!p) return ""; return p.y+"-"+String(p.m).padStart(2,"0")+"-"+String(p.d).padStart(2,"0"); }
function monthKey(s){ var p=parseDateAny(s); return p ? (p.y+"-"+String(p.m).padStart(2,"0")) : null; }
var MONTH_NAMES = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
function monthLabel(key){ var parts=key.split("-"); return MONTH_NAMES[+parts[1]-1]+" "+parts[0]; }
function monthOptionsFor(rows){
  var keys = Array.from(new Set(rows.map(function(r){return monthKey(r.created_date);}).filter(Boolean)));
  keys.sort();
  return keys.map(function(k){ return { value:k, label: monthLabel(k) }; });
}
function cleanComment(text){
  if(!text) return "";
  return String(text).replace(/^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\s*\([A-Z]+\)\s*/,"").trim();
}

