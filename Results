      '<div class="chart-grid-2">'+
        camChartHtml+
        '<div class="chart-card"><div class="clabel"><div class="clabel-bar"></div><span class="clabel-text">'+esc(sourceTitle)+'</span></div><div class="chart-wrap" style="height:130px;"><canvas id="c-source"></canvas></div></div>'+
      '</div>';

    if(ovCampaignChart){ ovCampaignChart.destroy(); ovCampaignChart=null; }
    if(camActive.length){ ovCampaignChart = hbarChart(document.getElementById("c-campaign"), camLabels, camValues, camColors); }

    if(ovSourceChart){ ovSourceChart.destroy(); ovSourceChart=null; }
    ovSourceChart = hbarChart(document.getElementById("c-source"), ["LinkedIn","Google"], [leadsF.length, gleadsF.length], [SOURCE_COLOR["LinkedIn"], SOURCE_COLOR["Google"]]);
  }
  draw();
}

/* ─────────────────── LinkedIn (all Pardot prospects) ─────────────────── */
function renderLinkedIn(){
  var el = document.getElementById("sec-linkedin");
  el.innerHTML =
    '<div class="sec-eyebrow">Pardot Prospects &middot; '+LEADS.length+' Records</div>'+
    '<div class="sec-title">LinkedIn Campaigns</div>'+
    '<div class="sec-desc">Everyone captured through a LinkedIn lead-gen campaign lands here first, as a Pardot prospect &mdash; before they ever become a Salesforce lead or contact. Quebec Bill 96 alone is 7 separate campaigns (the original launch plus 6 cohort-targeted ads) &mdash; filter by campaign or month to see exactly who’s in each one.</div>';

  var campaignOptions = CAMPAIGN_DEFS.map(function(c){
    var isQB96 = c.value.indexOf("QB96:")===0;
    return { value:c.value, label: isQB96 ? ("– "+c.label.replace("Quebec Bill 96 – ","")) : c.label, cls: isQB96 ? "sub" : "" };
  });
  campaignOptions.splice(2, 0, { value:"QB96_ALL", label:"Quebec Bill 96 (all 7 campaigns)", cls:"group" });

  var f = buildFilterBar(el, {
    selects: [
      { key:"campaign", label:"Campaign", options: campaignOptions },
      { key:"month", label:"Month", options: monthOptionsFor(LEADS) }
    ],
    onChange: function(){ draw(); }
  });
  window.__setLinkedInCampaignFilter = function(value){
    var sel = f.selects[0];
    if(!sel || !sel.setValue) return;
    if(value===""){ sel.setValue("", "All"); return; }
    var opt = campaignOptions.find(function(o){return o.value===value;});
    sel.setValue(value, opt ? opt.label.replace(/^–\s*/,"") : value);
  };
  window.__setLinkedInMonthFilter = function(value){
    var sel = f.selects[1];
    if(!sel || !sel.setValue) return;
    if(value===""){ sel.setValue("", "All"); return; }
    sel.setValue(value, monthLabel(value));
  };

  var heroWrap = document.createElement("div"); el.appendChild(heroWrap);
  var chartWrap = document.createElement("div"); el.appendChild(chartWrap);
  var tableContainer = document.createElement("div"); el.appendChild(tableContainer);
  el.insertAdjacentHTML("beforeend", '<div class="footer">GlobalLink by TransPerfect &middot; Lead Tracker</div>');

  var liCampaignChart = null;

  function draw(){
    var s = f.state;
    var out = LEADS.filter(function(r){
      var sv = specificCampaignValue(r);
      if(s.selects.campaign){
        if(s.selects.campaign === "QB96_ALL"){ if(r.campaign_group!=="Quebec Bill 96") return false; }
        else if(sv !== s.selects.campaign) return false;
      }
      if(s.selects.month && monthKey(r.created_date)!==s.selects.month) return false;
      if(s.search){ var q=s.search.toLowerCase(); if(!(r.first+" "+r.last+" "+r.email+" "+r.company+" "+r.title).toLowerCase().includes(q)) return false; }
      return true;
    });
    f.countEl.textContent = out.length+" of "+LEADS.length+" shown";

    var heroLabelParts = [];
    if(s.selects.campaign === "QB96_ALL") heroLabelParts.push("Quebec Bill 96 (all campaigns)");
    else if(s.selects.campaign) heroLabelParts.push(specificCampaignLabel(s.selects.campaign));
    else heroLabelParts.push("All LinkedIn campaigns");
    if(s.selects.month) heroLabelParts.push(monthLabel(s.selects.month));
    if(s.search) heroLabelParts.push('matching “'+esc(s.search)+'”');
    heroWrap.innerHTML =
      '<div class="stat-hero"><div class="stat-hero-value">'+out.length+'</div><div class="stat-hero-label">leads &mdash; <b>'+heroLabelParts.join(" &middot; ")+'</b></div></div>';

    /* Campaign breakdown chart — always reflects the Month/search filters so a filtered
       big number can still be traced back to which campaign(s) it came from. Ignores the
       Campaign select itself (that filter already tells you the campaign; the chart's job
       is to answer "which campaigns" when Campaign is set to All / Quebec Bill 96 (all)). */
    var chartRows = LEADS.filter(function(r){
      if(s.selects.month && monthKey(r.created_date)!==s.selects.month) return false;
      if(s.search){ var q=s.search.toLowerCase(); if(!(r.first+" "+r.last+" "+r.email+" "+r.company+" "+r.title).toLowerCase().includes(q)) return false; }
      return true;
    });
    var byCam = {};
    chartRows.forEach(function(r){ var v=specificCampaignValue(r); byCam[v]=(byCam[v]||0)+1; });
    var camActive = CAMPAIGN_DEFS.filter(function(c){ return (byCam[c.value]||0) > 0; });
    var camLabels = camActive.map(function(c){return c.label;});
    var camValues = camActive.map(function(c){return byCam[c.value]||0;});
    var camColors = camActive.map(function(c){return c.color;});
    var chartTitle = "Leads by Campaign"+(s.selects.month?" — "+monthLabel(s.selects.month):"")+(s.search?" (search filtered)":"");
    if(camActive.length){
      var camHeight = Math.max(70, camActive.length*32);
      chartWrap.innerHTML =
        '<div class="chart-card" style="margin-bottom:20px;"><div class="clabel"><div class="clabel-bar"></div><span class="clabel-text">'+esc(chartTitle)+'</span></div><div class="chart-wrap" style="height:'+camHeight+'px;"><canvas id="li-campaign-chart"></canvas></div></div>';
      if(liCampaignChart){ liCampaignChart.destroy(); liCampaignChart=null; }
      liCampaignChart = hbarChart(document.getElementById("li-campaign-chart"), camLabels, camValues, camColors);
    } else {
      if(liCampaignChart){ liCampaignChart.destroy(); liCampaignChart=null; }
      chartWrap.innerHTML =
        '<div class="chart-card" style="margin-bottom:20px;"><div class="clabel"><div class="clabel-bar"></div><span class="clabel-text">'+esc(chartTitle)+'</span></div><div style="padding:24px 4px;color:var(--muted);font-size:13px;">No leads match this filter.</div></div>';
    }

    tableContainer.innerHTML = "";
    renderTableCard(tableContainer, ["Name","Company","Title","Campaign","Score","MQL","Created"], out, function(r){
      var sv = specificCampaignValue(r);
      return '<tr>'+
        '<td><div class="cell-name">'+esc(r.first)+' '+esc(r.last)+'</div><div class="cell-sub">'+esc(r.email)+'</div></td>'+
        '<td>'+esc(r.company)+'</td><td>'+esc(r.title)+'</td>'+
        '<td>'+badge(specificCampaignLabel(sv), CAMPAIGN_COLOR_MAP[sv])+'</td>'+
        '<td>'+(r.score!==null?r.score:"&mdash;")+'</td>'+
        '<td>'+(r.real_mql?badge("Genuine MQL",CI.G):(r.glitch_mql?'<span class="cell-sub">Glitch date</span>':""))+'</td>'+
        '<td class="date-col">'+dateShort(r.created_date)+'</td></tr>';
    });
  }
  draw();
}

/* ─────────────────── Google (Salesforce Hot Leads) ─────────────────── */
function renderGoogle(){
  var el = document.getElementById("sec-google");
  el.innerHTML =
    '<div class="sec-eyebrow">Salesforce Hot Leads &middot; '+GLEADS.length+' Leads</div>'+
    '<div class="sec-title">Google Search</div>'+
    '<div class="sec-desc">These leads already live in Salesforce as full Leads &mdash; they\'re "hot" because the person redirected to the contact-us page after a Google search ad. Fields here (GA campaign, sales vertical, conversion URL) come straight from the Salesforce Hot Leads report, not Pardot.</div>';
  var statusOpts = ["New","Qualified","Assigned","In Process","Disqualified","Recycle","Recycled"];
  var vertOpts = Array.from(new Set(GLEADS.map(function(r){return r.vertical;}))).filter(Boolean).sort();
  var f = buildFilterBar(el, {
    searchPlaceholder: "Search name, company, title, GA campaign…",
    selects: [
      { key:"lead_status", label:"Lead status", options: statusOpts.map(function(c){return {value:c,label:c};}) },
      { key:"vertical", label:"Vertical", options: vertOpts.map(function(c){return {value:c,label:c};}) },
      { key:"month", label:"Month", options: monthOptionsFor(GLEADS) }
    ],
    onChange: function(){ draw(); }
  });
  window.__setGoogleMonthFilter = function(value){
    var sel = f.selects[2];
    if(!sel || !sel.setValue) return;
    if(value===""){ sel.setValue("", "All"); return; }
    sel.setValue(value, monthLabel(value));
  };
  /* Fixed GA campaign order (by overall volume) so the breakdown chart's bars stay in
     the same position as filters are applied — a campaign just drops to 0 rather than
     disappearing and reshuffling the rest. */
  var gaCounts = {};
  GLEADS.forEach(function(r){ var k=r.ga_campaign||"No campaign tag"; gaCounts[k]=(gaCounts[k]||0)+1; });
  var gaOrder = Object.keys(gaCounts).sort(function(a,b){ return gaCounts[b]-gaCounts[a]; });

  var heroWrap = document.createElement("div"); el.appendChild(heroWrap);
  var chartWrap = document.createElement("div"); el.appendChild(chartWrap);
  var tableContainer = document.createElement("div"); el.appendChild(tableContainer);
  el.insertAdjacentHTML("beforeend", '<div class="footer">GlobalLink by TransPerfect &middot; Lead Tracker</div>');

  var gaCampaignChart = null;

  function draw(){
    var s = f.state;
    var out = GLEADS.filter(function(r){
      if(s.selects.lead_status && r.lead_status!==s.selects.lead_status) return false;
      if(s.selects.vertical && r.vertical!==s.selects.vertical) return false;
      if(s.selects.month && monthKey(r.created_date)!==s.selects.month) return false;
      if(s.search){ var q=s.search.toLowerCase(); if(!(r.first+" "+r.last+" "+r.email+" "+r.company+" "+r.title+" "+r.ga_campaign).toLowerCase().includes(q)) return false; }
      return true;
    });
    f.countEl.textContent = out.length+" of "+GLEADS.length+" shown";

    var heroLabelParts = [];
    if(s.selects.lead_status) heroLabelParts.push(s.selects.lead_status);
    if(s.selects.vertical) heroLabelParts.push(s.selects.vertical);
    if(s.selects.month) heroLabelParts.push(monthLabel(s.selects.month));
    if(s.search) heroLabelParts.push('matching “'+esc(s.search)+'”');
    heroWrap.innerHTML =
      '<div class="stat-hero"><div class="stat-hero-value">'+out.length+'</div><div class="stat-hero-label">hot leads'+(heroLabelParts.length?' &mdash; <b>'+heroLabelParts.join(" &middot; ")+'</b>':' &mdash; <b>all Google search leads</b>')+'</div></div>';

    /* GA Campaign breakdown chart — recomputed from the same filtered set as the table,
       so it always shows exactly which GA4 campaigns the current big number came from. */
    var byGA = {};
    out.forEach(function(r){ var k=r.ga_campaign||"No campaign tag"; byGA[k]=(byGA[k]||0)+1; });
    var gaActive = gaOrder.filter(function(k){ return (byGA[k]||0) > 0; });
    var gaLabels = gaActive;
    var gaValues = gaActive.map(function(k){ return byGA[k]||0; });
    var gaColors = gaActive.map(function(){ return CI.G; });
    var gaTitle = "Leads by GA Campaign"+(heroLabelParts.length?" — "+heroLabelParts.join(" · "):"");
    if(gaActive.length){
      var gaHeight = Math.max(70, gaActive.length*32);
      chartWrap.innerHTML =
        '<div class="chart-card" style="margin-bottom:20px;"><div class="clabel"><div class="clabel-bar"></div><span class="clabel-text">'+esc(gaTitle)+'</span></div><div class="chart-wrap" style="height:'+gaHeight+'px;"><canvas id="g-campaign-chart"></canvas></div></div>';
      if(gaCampaignChart){ gaCampaignChart.destroy(); gaCampaignChart=null; }
      gaCampaignChart = hbarChart(document.getElementById("g-campaign-chart"), gaLabels, gaValues, gaColors);
    } else {
      if(gaCampaignChart){ gaCampaignChart.destroy(); gaCampaignChart=null; }
      chartWrap.innerHTML =
        '<div class="chart-card" style="margin-bottom:20px;"><div class="clabel"><div class="clabel-bar"></div><span class="clabel-text">'+esc(gaTitle)+'</span></div><div style="padding:24px 4px;color:var(--muted);font-size:13px;">No leads match this filter.</div></div>';
    }

    tableContainer.innerHTML = "";
    renderTableCard(tableContainer, ["Name","Company","Title","GA Campaign","Conversion URL","Vertical","Status","Converted","Comment","Created"], out, function(r){
      var comment = cleanComment(r.comments);
      return '<tr>'+
        '<td><div class="cell-name">'+esc(r.first)+' '+esc(r.last)+'</div><div class="cell-sub">'+esc(r.email)+'</div></td>'+
        '<td>'+esc(r.company)+'</td><td>'+esc(r.title)+'</td>'+
        '<td>'+(r.ga_campaign?esc(r.ga_campaign):'<span class="cell-sub">&mdash;</span>')+'</td>'+
        '<td>'+(r.conversion_url?'<a class="ext-link" href="'+esc(r.conversion_url)+'" target="_blank" rel="noopener" title="'+esc(r.conversion_url)+'">Open &#8599;</a>':'<span class="cell-sub">&mdash;</span>')+'</td>'+
        '<td>'+esc(r.vertical)+'</td>'+
        '<td>'+statusPill(r.lead_status)+'</td>'+
        '<td>'+(r.converted?badge("Converted",CI.G):'<span class="cell-sub">No</span>')+'</td>'+
        '<td style="max-width:260px;white-space:normal;">'+(comment?esc(comment):'<span class="cell-sub">&mdash;</span>')+'</td>'+
        '<td class="date-col">'+dateShort(r.created_date)+'</td></tr>';
    });
  }
  draw();
}

/* ─────────────────── Header stats ─────────────────── */
function renderHeaderStats(){
  var totalCombined = STATS.pardot_total + STATS.google_total;
  document.getElementById("header-stats").innerHTML =
    '<div class="hstat"><div class="hstat-num">'+fmt(totalCombined)+'</div><div class="hstat-label">Total Leads Captured</div></div>'+
    '<div class="hstat"><div class="hstat-num">9</div><div class="hstat-label">LinkedIn Campaigns</div></div>'+
    '<div class="hstat"><div class="hstat-num">'+STATS.google_total+'</div><div class="hstat-label">Google Hot Leads</div></div>'+
    '<div class="hstat"><div class="hstat-num">'+(STATS.by_campaign["Quebec Bill 96"]||0)+'</div><div class="hstat-label">Quebec Bill 96 Leads</div></div>';
}

renderHeaderStats();
renderOverview();
renderLinkedIn();
renderGoogle();
</script>
