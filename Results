<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>GlobalLink · Lead Tracker</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet"/>
<style>
/* ── TRANSPERFECT 2026 BRAND TOKENS ── */
:root {
  --blue-primary: #003FC7;
  --blue-dark:    #03002C;
  --blue-mid:     #002673;
  --blue-light:   #4D88FF;
  --blue-pale:    #D2E6FA;
  --blue-wash:    #F0F4FA;
  --teal:   #3BBFB5;
  --purple: #6531CC;
  --orange: #FA6419;
  --green:  #3EB236;
  --pink:   #ec388a;
  --text:   #03002C;
  --muted:  #5A6A8A;
  --border: #D2E6FA;
  --surface: #F0F4FA;
  --white:  #ffffff;
  --shadow: 0 2px 16px rgba(0,63,199,0.08);
  --shadow-hover: 0 6px 28px rgba(0,63,199,0.14);
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',sans-serif;background:var(--blue-wash);color:var(--text);min-height:100vh;}

/* ── HEADER ── */
.site-header{background:#03002C;padding:44px 60px 40px;position:relative;overflow:hidden;}
.site-header::before{content:"";position:absolute;left:-120px;top:-140px;width:580px;height:580px;border-radius:50%;
  background:radial-gradient(circle at 40% 40%, rgba(140,90,255,.55) 0%, rgba(100,60,220,.3) 40%, transparent 72%);pointer-events:none;}
.site-header::after{content:"";position:absolute;right:-80px;bottom:-80px;width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle at 60% 60%, rgba(161,251,249,.45) 0%, rgba(59,191,181,.2) 50%, transparent 72%);pointer-events:none;}
.orb-mid{position:absolute;right:28%;top:-60px;width:280px;height:280px;border-radius:50%;
  background:radial-gradient(circle, rgba(77,136,255,.35) 0%, transparent 70%);pointer-events:none;}
.header-inner{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:20px;position:relative;z-index:2;}
.header-badge{display:inline-block;background:rgba(161,251,249,.12);border:1px solid rgba(161,251,249,.3);color:#A1FBF9;font-size:10px;font-weight:600;letter-spacing:2.5px;text-transform:uppercase;padding:4px 14px;border-radius:20px;margin-bottom:14px;}
.header-title{font-size:36px;font-weight:800;color:#fff;line-height:1.08;letter-spacing:-0.5px;}
.header-title em{font-style:normal;color:#A1FBF9;}
.header-sub{color:rgba(255,255,255,.45);font-size:13px;margin-top:6px;font-weight:300;}
.header-stats{display:flex;gap:32px;margin-top:24px;flex-wrap:wrap;}
.hstat{border-left:2px solid rgba(161,251,249,.35);padding-left:14px;}
.hstat-num{font-size:24px;font-weight:800;color:#fff;}
.hstat-label{font-size:10px;color:rgba(255,255,255,.45);letter-spacing:.5px;}
.header-btns{display:flex;gap:8px;align-items:center;position:relative;z-index:2;}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.25);border-radius:8px;padding:8px 18px;font-size:12px;font-weight:500;cursor:pointer;font-family:'Inter',sans-serif;transition:all .2s;}
.btn-ghost:hover{background:rgba(255,255,255,.2);}

/* ── NAV ── */
.nav-bar{display:flex;gap:4px;background:#fff;padding:10px 60px;border-bottom:1px solid var(--border);overflow-x:auto;position:sticky;top:0;z-index:100;box-shadow:0 2px 16px rgba(0,63,199,.07);}
.nav-tab{padding:9px 22px;border-radius:8px;font-size:13px;font-weight:500;cursor:pointer;white-space:nowrap;color:var(--muted);background:transparent;border:none;transition:all .18s;font-family:'Inter',sans-serif;display:flex;align-items:center;gap:7px;}
.nav-tab:hover{background:var(--blue-wash);color:var(--blue-primary);}
.nav-tab.active{background:var(--blue-dark);color:#fff;}

/* ── SECTIONS ── */
.section{padding:40px 60px 60px;display:none;}
.section.active{display:block;}
.sec-eyebrow{font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--blue-light);margin-bottom:6px;}
.sec-title{font-size:28px;font-weight:800;color:var(--blue-dark);margin-bottom:6px;}
.sec-desc{color:var(--muted);font-size:14px;max-width:720px;margin-bottom:24px;line-height:1.7;font-weight:300;}
.section-label{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--blue-primary);margin-bottom:16px;padding-bottom:8px;border-bottom:2px solid var(--border);margin-top:4px;}

/* ── FILTER BAR ── */
.filter-bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:20px;background:#fff;border:1.5px solid var(--border);border-radius:12px;padding:14px 20px;box-shadow:var(--shadow);}
.search-input{border:1.5px solid var(--border);border-radius:8px;padding:6px 12px;font-size:12px;font-family:'Inter',sans-serif;color:var(--text);background:var(--white);min-width:220px;flex:1 1 220px;outline:none;transition:border .18s;}
.search-input:focus{border-color:var(--blue-primary);}
.fdivider{width:1px;height:22px;background:var(--border);margin:0 8px;}
.custom-select{position:relative;user-select:none;}
.custom-select-trigger{display:flex;align-items:center;gap:8px;border:1.5px solid var(--border);border-radius:8px;padding:5px 12px;font-size:11px;font-weight:500;color:var(--muted);background:var(--white);cursor:pointer;font-family:'Inter',sans-serif;transition:all .18s;white-space:nowrap;}
.custom-select-trigger:hover{border-color:var(--blue-primary);color:var(--blue-primary);}
.custom-select.open .custom-select-trigger{border-color:var(--blue-primary);color:var(--blue-primary);}
.custom-select.open .cs-chevron{transform:rotate(180deg);}
.cs-chevron{transition:transform .2s;flex-shrink:0;color:inherit;}
.custom-select-menu{display:none;position:absolute;top:calc(100% + 6px);left:0;background:#fff;border:1.5px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,63,199,.12);z-index:999;min-width:210px;max-height:320px;overflow-y:auto;padding:4px;}
.custom-select.open .custom-select-menu{display:block;}
.custom-select-option{padding:8px 12px;font-size:11px;font-weight:500;color:var(--muted);cursor:pointer;border-radius:7px;transition:all .15s;font-family:'Inter',sans-serif;white-space:nowrap;}
.custom-select-option:hover{background:var(--blue-wash);color:var(--blue-primary);}
.custom-select-option.selected{background:var(--blue-wash);color:var(--blue-primary);font-weight:700;}
.custom-select-option.sub{padding-left:24px;font-weight:400;}
.custom-select-option.group{font-weight:700;color:var(--blue-dark);}
.filter-count{margin-left:auto;font-size:11px;color:#a0b4c8;white-space:nowrap;}

/* ── STAT HERO (dynamic big number) ── */
.stat-hero{display:flex;align-items:center;gap:20px;background:#fff;border:1.5px solid var(--border);border-radius:14px;padding:22px 26px;margin-bottom:20px;box-shadow:var(--shadow);border-left:4px solid var(--blue-primary);}
.stat-hero-value{font-size:44px;font-weight:800;color:var(--blue-dark);line-height:1;white-space:nowrap;}
.stat-hero-label{font-size:13px;color:var(--muted);font-weight:500;}
.stat-hero-label b{color:var(--blue-primary);}

/* ── KPI CARDS ── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(158px,1fr));gap:14px;margin-bottom:28px;}
.kpi-card{background:#fff;border:1.5px solid var(--border);border-radius:14px;padding:20px 22px;position:relative;overflow:hidden;box-shadow:var(--shadow);transition:box-shadow .2s,border-color .2s,transform .08s;cursor:pointer;}
.kpi-card:hover{box-shadow:var(--shadow-hover);border-color:var(--blue-primary);transform:translateY(-1px);}
.kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:14px 14px 0 0;}
.kpi-b::before{background:var(--blue-primary);} .kpi-b .kpi-value{color:var(--blue-primary);}
.kpi-d::before{background:var(--blue-dark);}
.kpi-t::before{background:var(--teal);} .kpi-t .kpi-value{color:var(--teal);}
.kpi-o::before{background:var(--orange);} .kpi-o .kpi-value{color:var(--orange);}
.kpi-p::before{background:var(--purple);} .kpi-p .kpi-value{color:var(--purple);}
.kpi-label{font-size:9px;font-weight:700;color:#a0b4c8;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px;}
.kpi-value{font-size:28px;font-weight:800;color:var(--blue-dark);line-height:1;}
.kpi-sub{font-size:11px;color:#a0b4c8;margin-top:6px;}

/* ── CHART CARDS ── */
.chart-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
.chart-card{background:#fff;border:1.5px solid var(--border);border-radius:14px;padding:20px 18px 14px;box-shadow:var(--shadow);transition:border-color .2s;}
.chart-card:hover{border-color:var(--blue-primary);}
.chart-wrap{background:var(--blue-wash);border-radius:8px;padding:10px 6px 6px;}
.clabel{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
.clabel-bar{width:3px;height:14px;background:linear-gradient(180deg,var(--blue-primary),var(--blue-dark));border-radius:2px;}
.clabel-text{font-size:9px;font-weight:700;color:#a0b4c8;letter-spacing:2px;text-transform:uppercase;}

/* ── TABLE ── */
.table-card{background:#fff;border:1.5px solid var(--border);border-radius:14px;padding:20px 18px 8px;overflow:auto;box-shadow:var(--shadow);max-height:640px;}
table{width:100%;border-collapse:collapse;font-size:12px;}
thead th{position:sticky;top:0;background:#fff;text-align:left;padding:8px 12px;color:#a0b4c8;font-weight:700;font-size:9px;letter-spacing:1.2px;text-transform:uppercase;white-space:nowrap;border-bottom:2px solid var(--blue-wash);z-index:2;}
tbody tr{border-bottom:1px solid var(--blue-wash);transition:background .15s;}
tbody tr:hover td{background:var(--blue-wash);}
td{padding:9px 12px;vertical-align:top;}
.cell-name{font-weight:600;color:var(--blue-dark);}
.cell-sub{color:#a0b4c8;font-size:10.5px;}
.badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:10px;font-weight:600;white-space:nowrap;}
.badge .sw{width:6px;height:6px;border-radius:50%;flex:0 0 auto;background:currentColor;}
.badge-neutral{background:var(--blue-wash);color:var(--muted);}
.empty-row td{text-align:center;padding:40px 20px;color:#a0b4c8;font-size:12px;}
a.ext-link{color:var(--blue-primary);text-decoration:none;font-size:10.5px;}
a.ext-link:hover{text-decoration:underline;}
.date-col{white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--muted);font-size:11px;}

.footer{text-align:center;color:#a0b4c8;font-size:10px;letter-spacing:1.5px;padding:24px 0 8px;font-weight:500;text-transform:uppercase;}

@media(max-width:820px){
  .chart-grid-2{grid-template-columns:1fr;}
  .section,.site-header,.nav-bar{padding-left:20px;padding-right:20px;}
  .filter-count{width:100%;margin-left:0;}
  .stat-hero-value{font-size:34px;}
}
</style>
</head>
